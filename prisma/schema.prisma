  @@index([eventId, participantType])
}

/// Bulk import (students, teachers, schools, questions, beneficiaries, curriculum).
model ImportJob {
  id           String    @id @default(cuid())
  code         String    @unique // IMP-000007
  type         String    // students | teachers | schools | questions | beneficiaries | curriculum
  status       String    @default("uploaded") // uploaded | validating | validated | approved | processing | completed | failed | cancelled
  fileId       String    // StoredFile with original CSV/XLSX
  fileName     String
  context      Json      @default("{}") // e.g. { schoolId, programmeId, curriculumVersionId }
  totalRows    Int       @default(0)
  validRows    Int       @default(0)
  invalidRows  Int       @default(0)
  createdRows  Int       @default(0)
  skippedRows  Int       @default(0)
  errors       Json      @default("[]") // [{ row: 7, field: "grade", code: "out_of_range", message: "Class must be 3-12" }]
  uploadedById String
  approvedById String?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type, status])
}

// â”€â”€ Control Centre: Operations & Approvals â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Approval {
  id                 String    @id @default(cuid())
  code               String    @unique // APR-000001
  type               String    // plan_version | refund | ai_routing | expense | programme | grant_agreement | programme_amendment | inter_entity_foundation | inter_entity_final | exam_regrade | teacher_assignment | content_review | manual_entitlement | period_reopen | beneficiary_pii_access
  entityType         String
  entityId           String
  legalEntityId      String?
