model AiClub {
  id           String    @id @default(cuid())
  schoolId     String
  name         String
  leaderUserId String?   // campus leader
  programmeId  String?
  status       String    @default("active") // active | inactive
  startedOn    DateTime  @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

model ActivationEvent {
  id              String                 @id @default(cuid())
  code            String                 @unique // ACT-000020
  schoolId        String?
  programmeId     String?
  type            String                 // campus_leader_session | ai_club_meeting | parent_session | teacher_session | community_event
