// Progga AI data model.
// Runs on PostgreSQL (e.g. Neon). Enum-like columns are plain strings validated
// by Zod in the API layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection: used by the app (serverless-friendly).
  url       = env("DATABASE_URL")
  // Direct connection: used by `prisma db push` / migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique // email or phone signs in; kids added by a parent have neither
  phone           String?  @unique // +8801XXXXXXXXX
  passwordHash    String
  name            String
  role            String   @default("STUDENT") // STUDENT | PARENT | TEACHER | ADMIN | STAFF
  accountStatus   String   @default("active")  // invited | registered | active | suspended | closed
  statusReason    String?                      // last suspension/closure reason (also in AuditLog)
  statusChangedAt DateTime?
  isTestAccount   Boolean  @default(false)     // excluded from every metric
  lastSeenAt      DateTime?                    // last authenticated request of any kind (updated at most every 5 min)
  grade           Int? // 3..12 (11-12 = HSC). Students only.
  birthdate       String? // YYYY-MM-DD
  motivation      String? // excel | sharp | fun | help_child (picked at signup)
  profile         Json     @default("{}") // about me, school, family, guardianâ€¦ (shape in modules/users/profile.ts)
  photoUpdatedAt  DateTime? // set while a profile photo exists; versions the photo URL
  language        String   @default("en") // en | bn
  avatarSkin      String   @default("classic")
  xp              Int      @default(0)
  coins           Int      @default(0)
  streakDays      Int      @default(0)
  bestStreak      Int      @default(0)
  lastActiveDate  String? // YYYY-MM-DD in Asia/Dhaka
  linkCode        String   @unique // shared with a parent/teacher to link accounts
  dailyTutorLimit Int      @default(25)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tutorSessions  TutorSession[]
  xpEvents       XpEvent[]
  badges         UserBadge[]
  items          UserItem[]
  questClaims    QuestClaim[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  safetyEvents   SafetyEvent[]
  guardianOf     GuardianLink[]   @relation("guardian")
  guardedBy      GuardianLink[]   @relation("student")
  battleProfiles BattleProfile[]
  battleTicket   BattleTicket?
  battlePlayers  BattlePlayer[]
  photo          ProfilePhoto?

  // Identity & Control Centre relations
  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  staffProfile       StaffProfile?
  roleAssignments    RoleAssignment[]
  memberships        SchoolMembership[]
  consentsAsStudent  Consent[]        @relation("consentStudent")
  enrolments         Enrolment[]
  subscriptions      Subscription[]
  entitlement        Entitlement?
  payments           PaymentTransaction[]
  invoices           Invoice[]
  beneficiaries      Beneficiary[]

  @@index([role, accountStatus])
  @@index([createdAt])
}

/// Profile picture, resized on the device before upload (small square JPEG/WebP).
model ProfilePhoto {
  userId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuardianLink {
  id                 String    @id @default(cuid())
  guardianId         String
  studentId          String
  status             String    @default("active") // pending | active | revoked
  relation           String?                      // father | mother | brother | sister | uncle | aunt | grandparent | other | teacher
  isVerified         Boolean   @default(false)    // contact verified + linkage confirmed
  verifiedAt         DateTime?
  verificationMethod String?                      // link_code | otp_sms | otp_email | school_record | admin_override
  canManageBilling   Boolean   @default(false)    // only true when isVerified and relation is a parent/legal guardian
  revokedAt          DateTime?
  revokedById        String?                      // soft ref
  revokedReason      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  guardian           User      @relation("guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student            User      @relation("student", fields: [studentId], references: [id], onDelete: Cascade)
  consents           Consent[]

  @@unique([guardianId, studentId])
  @@index([studentId, status])
}

// â”€â”€ Socratic tutor â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model TutorSession {
  id            String         @id @default(cuid())
  studentId     String
  subject       String
  grade         Int
  mode          String // problem | concept | fact
  kind          String         @default("question") // question (asked by the student) | lesson (a syllabus topic taught from scratch)
  language      String         @default("en") // language the hidden plan is written in
  title         String
  topic         String         @default("")
  problemText   String
  hadImage      Boolean        @default(false)
  status        String         @default("active") // active | solved | abandoned
  plan          Json // hidden lesson plan (steps, expected answers, hints, final answer)
  progress      Json // per-step runtime state: attempts, hints shown, revealed
  currentStep   Int            @default(0)
  hintsUsed     Int            @default(0)
  wrongAttempts Int            @default(0)
  xpEarned      Int            @default(0)
  lessonId      String? // asked from inside this video lesson
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson        Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages      TutorMessage[]

  @@index([studentId, createdAt])
}

model TutorMessage {
  id        String       @id @default(cuid())
  sessionId String
  role      String // student | tutor
  kind      String       @default("text") // text | question | hint | feedback | why | celebrate | recap | reveal | safety
  content   String
  stepIndex Int?
  meta      Json?
  createdAt DateTime     @default(now())
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speech    SpeechClip?

  @@index([sessionId, createdAt])
}

// Progga's spoken version of a tutor message (read-aloud), generated once and
// reused on replay. Keyed by voice/model so a settings change regenerates it.
/// NCTB chapters and topics for a class + subject without a seeded course, written once by the AI.
model SyllabusCache {
  grade     Int
  subject   String
  language  String
  chapters  Json // [{ title, topics: string[] }]
  createdAt DateTime @default(now())

  @@id([grade, subject, language])
}

model SpeechClip {
  messageId String       @id
  voice     String
  model     String
  audio     Bytes // audio/mpeg
  createdAt DateTime     @default(now())
  message   TutorMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model SafetyEvent {
  id        String   @id @default(cuid())
  userId    String
  category  String // unsafe | personal_info | off_topic | wellbeing
  excerpt   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// â”€â”€ Gamification â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // tutor_step | tutor_step_clean | tutor_solved | lesson_complete | checkpoint | quiz_correct | quiz_finish | quest | streak
  refId     String?
  day       String // YYYY-MM-DD (Asia/Dhaka) for fast daily quest + streak queries
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@index([createdAt])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model UserItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model QuestClaim {
  id        String   @id @default(cuid())
  userId    String
  questId   String
  day       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, day])
}

// â”€â”€ App settings (e.g. which AI provider/model is active) â”€â”€

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// â”€â”€ Content: subjects, video lessons, quizzes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Subject {
  id        String         @id // slug: math, science, ...
  name      String
  nameBn    String
  icon      String // emoji
  color     String // hex
  minGrade  Int
  maxGrade  Int
  order     Int            @default(0)
  lessons   Lesson[]
  questions QuizQuestion[]
  courses   Course[]
}

// A class-wise subject course that follows the NCTB textbook: Course → Chapter → Lesson (topic).
model Course {
  id          String      @id // slug: physics-10
  code        String?     @unique
  status      String      @default("draft") // draft | in_review | published | archived
  subjectId   String
  grade       Int
  title       String
  titleBn     String      @default("")
  book        String      @default("") // NCTB textbook the chapters follow
  description String      @default("")
  order       Int         @default(0)
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  subject     Subject     @relation(fields: [subjectId], references: [id])
  chapters    Chapter[]
  enrolments  Enrolment[]

  @@unique([subjectId, grade])
}

model Chapter {
  id        String   @id // physics-10-ch2
  courseId  String
  number    Int // NCTB chapter number
  title     String
  titleBn   String   @default("")
  summary   String   @default("")
  status    String   @default("draft")
  updatedAt DateTime @default(now()) @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@unique([courseId, number])
}

model Lesson {
  id          String           @id @default(cuid())
  code        String?          @unique
  status      String           @default("draft") // draft | in_review | published | archived
  subjectId   String
  grade       Int
  chapter     String
  title       String
  description String
  provider    String // youtube | mp4
  videoUrl    String // YouTube video id or mp4 URL
  durationSec Int
  xpReward    Int              @default(20)
  checkpoints Json // [{ atSec, question, options[], answerIndex, explanation }]
  order       Int              @default(0)
  // Course topics: the chapter they belong to and a written lesson (Markdown + $maths$)
  chapterId   String?
  body        String           @default("")
  readingMin  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  subject     Subject          @relation(fields: [subjectId], references: [id])
  unit        Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  progress    LessonProgress[]
  questions   TutorSession[]
  materials   LessonMaterial[]

  @@index([subjectId, grade])
  @@index([chapterId, order])
}

model LessonProgress {
  id                 String   @id @default(cuid())
  userId             String
  lessonId           String
  watchedSec         Int      @default(0)
  checkpointsCorrect Json     @default("[]") // indexes answered correctly
  readDone           Boolean  @default(false) // written lesson marked as read
  completed          Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson             Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model QuizQuestion {
  id          String  @id @default(cuid())
  subjectId   String
  grade       Int
  topic       String
  prompt      String
  options     Json // string[]
  answerIndex Int
  explanation String
  difficulty  Int     @default(1) // 1..3
  subject     Subject @relation(fields: [subjectId], references: [id])

  @@index([subjectId, grade])
}

model QuizAttempt {
  id           String    @id @default(cuid())
  userId       String
  subjectId    String
  grade        Int
  questionIds  Json // string[]
  answers      Json // [{ questionId, choice, correct, ms }]
  combo        Int       @default(0)
  bestCombo    Int       @default(0)
  hearts       Int       @default(3)
  score        Int       @default(0)
  correctCount Int       @default(0)
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// â”€â”€ Battle Arena (1v1 live quiz battles, one trophy league per class) â”€â”€

/// A student's trophies and record in one class's league.
model BattleProfile {
  id           String   @id @default(cuid())
  userId       String
  grade        Int
  trophies     Int      @default(0)
  bestTrophies Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  winStreak    Int      @default(0) // current form: +3 = three wins in a row, âˆ’2 = two losses in a row
  bestStreak   Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, grade])
  @@index([grade, trophies])
}

/// A student waiting in matchmaking. One per student; removed once matched or cancelled.
model BattleTicket {
  id         String   @id @default(cuid())
  userId     String   @unique
  grade      Int
  trophies   Int
  botAt      DateTime // when to stop waiting for a human and bring in a practice rival
  lastSeenAt DateTime @default(now()) // tickets that stop polling are skipped by matchmaking
  battleId   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([grade, battleId, lastSeenAt])
}

model Battle {
  id         String         @id @default(cuid())
  grade      Int
  difficulty Int // 1..5, from the players' league
  vsBot      Boolean        @default(false)
  questions  Json // [{ id, subject, topic, prompt, promptBn, options, optionsBn, answerIndex, explanation }]
  startsAt   DateTime
  deadline   DateTime // after this, unanswered questions count as timeouts
  status     String         @default("live") // live | done
  finishedAt DateTime?
  createdAt  DateTime       @default(now())
  players    BattlePlayer[]

  @@index([status, deadline])
}

model BattlePlayer {
  id                String    @id @default(cuid())
  battleId          String
  userId            String? // null for a practice rival (bot)
  isBot             Boolean   @default(false)
  name              String
  skin              String    @default("classic")
  level             Int       @default(1)
  trophiesBefore    Int
  answers           Json      @default("[]") // [{ choice, correct, ms, at }]; a bot's are planned ahead with `at` = ms after start
  answered          Int       @default(0) // questions answered (or timed out) so far
  score2            Int       @default(0) // score Ã— 2 (correct +2, wrong âˆ’1) so âˆ’0.5 stays an integer
  totalMs           Int       @default(0) // thinking time, the tie-breaker
  questionStartedAt DateTime
  finishedAt        DateTime?
  result            String? // win | loss | draw
  trophyDelta       Int       @default(0)
  xpGained          Int       @default(0)
  battle            Battle    @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([userId, battleId])
}

// â”€â”€ Control Centre: Identity & Access â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Legal entities whose books must never be merged. Seeded: ltd, foundation.
model LegalEntity {
  id        String   @id // "ltd" | "foundation"
  name      String   // "Progga Technologies Ltd." | "Progga Foundation"
  type      String   // company | foundation
  currency  String   @default("BDT")
  createdAt DateTime @default(now())
}

/// Portal-specific data for STAFF/ADMIN users.
model StaffProfile {
  userId             String    @id
  title              String    @default("")      // job title
  department         String    @default("")
  mfaSecretEnc       String?                      // AES-256-GCM ciphertext (base64) of TOTP secret
  mfaEnrolledAt      DateTime?
  recoveryCodeHashes String[]  @default([])       // bcrypt hashes, removed when used
  lastAssignmentId   String?                      // last workspace used (convenience only)
  mustChangePassword Boolean   @default(false)    // true for staff created with a temporary password
  invitedById        String?
  invitedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id            String   @id @default(cuid())
  key           String   @unique // SUPER_ADMIN, EXECUTIVE, ... (UPPER_SNAKE)
  name          String
  description   String   @default("")
  permissions   String[] // permission codes from src/admin/core/permissions.ts
  allowedScopes String[] // subset of GLOBAL | LEGAL_ENTITY | SCHOOL | PROGRAMME | PARTNER
  isSystem      Boolean  @default(false) // seeded roles cannot be edited or deleted
  status        String   @default("active") // active | retired
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)
  assignments   RoleAssignment[]
}

/// One role granted to one user within one scope = one "workspace".
model RoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  roleId      String
  scopeType   String    // GLOBAL | LEGAL_ENTITY | SCHOOL | PROGRAMME | PARTNER
  scopeId     String?   // null for GLOBAL; legalEntityId / schoolId / programmeId / partnerId otherwise
  status      String    @default("active") // active | suspended | revoked
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  reason      String    @default("")
  grantedById String?
  revokedById String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId, status])
}

/// Guardian-consent policy texts. A consent is always given against one version.
model ConsentPolicy {
  id            String   @id @default(cuid())
  consentType   String   // data_processing | ai_tutoring | progress_reports | marketing_to_guardian
  version       String   // "2026.1"
  title         String
  bodyMarkdown  String
  effectiveFrom DateTime @db.Date
  status        String   @default("draft") // draft | active | superseded
  createdById   String?
  createdAt     DateTime @default(now())
  consents      Consent[]

  @@unique([consentType, version])
}

/// Append-style consent record: a grant row is never edited except to set revoke fields once.
model Consent {
  id              String    @id @default(cuid())
  studentId       String
  guardianLinkId  String?   // null when consent recorded by school under agreement
  policyId        String
  consentType     String    // copy of policy.consentType for querying
  status          String    // granted | revoked
  method          String    // in_app | paper_form | school_agreement | sms_otp
  evidenceEnc     String?   // AES-GCM encrypted evidence note / file id
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedReason   String?
  recordedById    String?   // staff who recorded a paper consent
  student         User      @relation("consentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  guardianLink    GuardianLink? @relation(fields: [guardianLinkId], references: [id], onDelete: SetNull)
  policy          ConsentPolicy @relation(fields: [policyId], references: [id])

  @@index([studentId, consentType, status])
}

model GuardianInvite {
  id          String    @id @default(cuid())
  studentId   String
  contact     String    // normalized email or +8801XXXXXXXXX
  relation    String
  tokenHash   String    @unique // sha256 of the invite token
  status      String    @default("sent") // sent | accepted | expired | cancelled
  expiresAt   DateTime
  sentById    String?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([studentId, status])
}

// â”€â”€ Control Centre: People & Institutions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model StudentProfile {
  userId                 String    @id
  code                   String    @unique // STU-000123
  schoolId               String?   // current school (denormalized from active SchoolMembership)
  division               String?
  district               String?   // copied from User.profile.district on backfill; admin-editable
  upazila                String?
  section                String?
  effectiveAccess        String    @default("FREE") // FREE | PREMIUM_PAID | PREMIUM_SPONSORED (cached; recomputed by entitlement service)
  effectiveEntitlementId String?   // the Entitlement row that won
  guardianStatus         String    @default("none") // none | invited | linked_unverified | verified | consent_revoked (cached)
  acquisitionSource      String?   // organic | school | referral | campaign | sponsor | import
  acquisitionCampaign    String?
  referrerUserId         String?
  attributionVersion     String    @default("v1")
  firstActiveAt          DateTime?
  lastActiveAt           DateTime? // last meaningful activity (not passive login)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  version                Int       @default(1)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                 School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([effectiveAccess])
  @@index([district])
  @@index([lastActiveAt])
}

model TeacherProfile {
  userId             String              @id
  code               String              @unique // TCH-000045
  status             String              @default("active") // invited | active | inactive | suspended
  verificationStatus String              @default("unverified") // unverified | pending | verified | rejected
  verifiedAt         DateTime?
  verifiedById       String?
  primarySchoolId    String?
  subjectIds         String[]            @default([]) // Subject.id slugs
  grades             Int[]               @default([]) // classes taught 3..12
  district           String?
  upazila            String?
  lastActiveAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  version            Int                 @default(1)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  primarySchool      School?             @relation(fields: [primarySchoolId], references: [id], onDelete: SetNull)
  assignments        TeacherAssignment[]
  trainingEnrolments TrainingEnrolment[]

  @@index([primarySchoolId, status])
}

model School {
  id                 String              @id @default(cuid())
  code               String              @unique // SCH-000012
  name               String
  nameBn             String              @default("")
  eiin               String?             @unique // Bangladesh EIIN, 6 digits, optional
  type               String              // government | non_government | madrasa | english_medium | technical | other
  level              String              @default("secondary") // primary | secondary | higher_secondary | combined
  division           String
  district           String
  upazila            String
  address            String              @default("")
  contactName        String              @default("")
  contactPhone       String              @default("")
  contactEmail       String              @default("")
  onboardingStage    String              @default("created") // created | identifiers_verified | admin_nominated | members_imported | guardian_process_confirmed | entitlements_assigned | activated | adoption_review
  status             String              @default("active") // active | inactive | archived
  verifiedAt         DateTime?
  verifiedById       String?
  nameKey            String              // lowercased, whitespace-collapsed name used for duplicate detection
  createdById        String?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  version            Int                 @default(1)
  students           StudentProfile[]
  teachers           TeacherProfile[]
  memberships        SchoolMembership[]
  teacherAssignments TeacherAssignment[]
  aiClubs            AiClub[]
  activationEvents   ActivationEvent[]

  @@unique([nameKey, district, upazila]) // duplicate institution check
  @@index([district, upazila])
  @@index([status, onboardingStage])
}

/// Date-effective membership. A transfer ends one row (endDate) and starts another.
