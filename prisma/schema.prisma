/// Append-only (trigger blocks UPDATE/DELETE).
model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?  // null = system
  assignmentId  String?
  roleKey       String?
  action        String   // e.g. student.suspend, refund.approve, report.export, file.download, role.assign
  entityType    String
  entityId      String
  reason        String?
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model IdempotencyKey {
