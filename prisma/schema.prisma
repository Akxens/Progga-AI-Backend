  decidedById        String?
  decidedAt          DateTime?
  decisionReason     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)

  @@index([status, type])
  @@index([entityType, entityId])
