// ── Billing, Payments & Entitlements (Sprint 3 / Phase 4) ────────

model Plan {
  id          String        @id @default(cuid())
  code        String        @unique // PLN-000001
  name        String
  description String        @default("")
  accessType  String        @default("FREE") // FREE | PREMIUM_PAID | PREMIUM_SPONSORED
  status      String        @default("active") // active | draft | archived
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  versions    PlanVersion[]
}

model PlanVersion {
  id                 String         @id @default(cuid())
  planId             String
  versionNumber      Int            @default(1)
  priceAmount        Decimal        @db.Decimal(10, 2)
  currency           String         @default("BDT")
  billingInterval    String         @default("month") // month | year | one_time
  trialDays          Int            @default(0)
  quotas             Json           // { dailyTutorLimit: 100, voiceMinutesPerDay: 30, battleEnabled: true }
  status             String         @default("active") // draft | active | archived
  effectiveFrom      DateTime       @default(now())
  effectiveTo        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  plan               Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions      Subscription[]

  @@unique([planId, versionNumber])
}

model Subscription {
  id                 String               @id @default(cuid())
  code               String               @unique // SUB-000001
  studentId          String
  planVersionId      String
  status             String               @default("active") // trialing | active | past_due | cancelled | expired
  currentPeriodStart DateTime             @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean              @default(false)
  source             String               @default("b2c_online") // b2c_online | csr_grant | school_sponsored | manual_admin
  autoRenew          Boolean              @default(true)
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planVersion        PlanVersion          @relation(fields: [planVersionId], references: [id])
  payments           PaymentTransaction[]

  @@index([studentId, status])
}

model Entitlement {
  id                 String    @id @default(cuid())
  studentId          String    @unique
  source             String    @default("free") // paid | sponsored | free
  effectiveAccess    String    @default("FREE") // FREE | PREMIUM_PAID | PREMIUM_SPONSORED
  validFrom          DateTime  @default(now())
  validTo            DateTime?
  dailyTutorLimit    Int       @default(25)
  voiceMinutesPerDay Int       @default(0)
  battleEnabled      Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  code           String        @unique // TXN-000001
  studentId      String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("BDT")
  provider       String        @default("shurjopay") // shurjopay | bkash | nagad | manual
  providerTxnId  String?       @unique
  status         String        @default("pending") // pending | succeeded | failed | refunded
  method         String?       // bkash | card | nagad | bank
  metadata       Json?
  initiatedAt    DateTime      @default(now())
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice        Invoice?

  @@index([studentId, status])
  @@index([provider, providerTxnId])
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String    // shurjopay | bkash
  eventId     String?
  eventType   String    @default("payment_notification")
  payload     Json
  signature   String?
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, processed])
}

model Invoice {
  id                   String             @id @default(cuid())
  invoiceNumber        String             @unique // INV-YYYY-######
  studentId            String
  paymentTransactionId String             @unique
  amount               Decimal            @db.Decimal(10, 2)
  currency             String             @default("BDT")
  status               String             @default("paid") // issued | paid | void
  pdfPath              String?
  issuedAt             DateTime           @default(now())
  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model LedgerJournal {
  id            String        @id @default(cuid())
  code          String        @unique // JRN-000001
  legalEntityId String?
  entryType     String        // SUBSCRIPTION_PAYMENT | REFUND | CSR_GRANT
  description   String
  postedAt      DateTime      @default(now())
  postedById    String?
  createdAt     DateTime      @default(now())
  entries       LedgerEntry[]

