/// Work-queue assignment (DASH-03) for any queue item.
model WorkAssignment {
  id           String   @id @default(cuid())
  itemType     String   // payment_review | refund | content_review | safety_case | sponsorship_expiry | incident | approval | ticket
  itemId       String
  assigneeId   String
  assignedById String
  status       String   @default("open") // open | done
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([itemType, itemId])
  @@index([assigneeId, status])
}

model StoredFile {
  id            String    @id @default(cuid())
  purpose       String    // report | import | evidence | invoice | material | consent
  fileName      String
  mime          String
  sizeBytes     Int
  sha256        String
  storageDriver String    @default("db")
  data          Bytes?
  storageKey    String?
  sensitivity   String    @default("internal") // public | internal | restricted
  expiresAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
