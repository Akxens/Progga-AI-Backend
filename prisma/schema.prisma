  recordedById    String
  createdAt       DateTime  @default(now())
  programme       Programme @relation(fields: [programmeId], references: [id])
}

model Beneficiary {
  id               String        @id @default(cuid())
  programmeId      String
  studentId        String
  eligibilityState String        @default("pending") // pending | eligible | ineligible
  ineligibleReason String?
  verifiedAt       DateTime?
  verifiedById     String?
  status           String        @default("active") // active | removed
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  programme        Programme     @relation(fields: [programmeId], references: [id])
  student          User          @relation(fields: [studentId], references: [id])
  sponsorships     Sponsorship[]

  @@unique([programmeId, studentId])
}

model Sponsorship {
  id              String      @id @default(cuid())
  code            String      @unique // SPN-000001
  beneficiaryId   String
  programmeId     String
  studentId       String
  coverageFrom    DateTime    @db.Date
  coverageTo      DateTime    @db.Date
  fundedRate      Decimal     @db.Decimal(14, 2)
  allocatedAmount Decimal     @db.Decimal(14, 2)
  status          String      @default("active") // active | revoked | expired
  revokedAt       DateTime?
  revokedReason   String?
  entitlementId   String?
  idempotencyKey  String      @unique
  createdById     String
  createdAt       DateTime    @default(now())
  beneficiary     Beneficiary @relation(fields: [beneficiaryId], references: [id])

  @@index([studentId, status, coverageFrom, coverageTo])
  @@index([programmeId, status])
}

model InterEntityRequest {
  id                    String    @id @default(cuid())
  code                  String    @unique // IER-000001
  programmeId           String
  description           String
  amount                Decimal   @db.Decimal(14, 2)
  costRationale         String
  conflictDisclosure    String
  foundationPurchaseRef String
  ltdQuotationRef       String?
  ltdInvoiceId          String?
  contractRef           String?
  donorPermissionRef    String?
  attachmentFileIds     String[]  @default([])
  status                String    @default("draft") // draft | submitted | foundation_approved | donor_permission_recorded | approved | invoiced | paid | rejected | cancelled
  approvalIds           String[]  @default([])
  paidJournalId         String?
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  version               Int       @default(1)
  programme             Programme @relation(fields: [programmeId], references: [id])

  @@index([programmeId, status])
}
